  "contrast": {
    "_comment": "Every pairing the system actually puts on screen, and the ratio it must clear. The build computes these from each brand and refuses to compile a brand that fails one, so an illegal palette is a broken build rather than an accessibility finding six months later. Text needs 4.5 to 1 and anything structural needs 3 to 1, per WCAG 2.2 AA.",
    "text": [
      [
        "text-primary",
        "surface-page"
      ],
      [
        "text-primary",
        "surface-raised"
      ],
      [
        "text-secondary",
        "surface-page"
      ],
      [
        "text-secondary",
        "surface-raised"
      ],
      [
        "text-muted",
        "surface-raised"
      ],
      [
        "text-inverse",
        "surface-inverse"
      ],
      [
        "accent-contrast",
        "accent-base"
      ],
      [
        "accent-contrast",
        "accent-hover"
      ],
      [
        "status-success-fg",
        "status-success-bg"
      ],
      [
        "status-warning-fg",
        "status-warning-bg"
      ],
      [
        "status-danger-fg",
        "status-danger-bg"
      ],
      [
        "status-info-fg",
        "status-info-bg"
      ]
    ],
    "structural": [
      [
        "border-focus",
        "surface-page"
      ],
      [
        "border-focus",
        "surface-raised"
      ],
      [
        "border-strong",
        "surface-raised"
      ],
      [
        "accent-base",
        "surface-page"
      ]
    ]
  },
  "vendor": {
    "package": "@metatoy/bootstrap-styled",
    "allowed_in": "src/components",
    "stylesheet": "design-system/tokens.vendor.css",
    "properties": 31
  },
  "rules": [
    "Every value in a stylesheet is a var(--ds-*). A raw colour, length or duration the token layer already carries is a bug. If the layer is missing something, add it to the layer.",
    "At most one accented action per screen. The accent means the action this screen exists for, and the focus ring. Nothing else.",
    "Anything said with colour is also said with a word. Colour is never the only carrier of a state.",
    "Every actionable control is at least 44 pixels effective, and keyboard focus is always visible at two pixels in the focus colour.",
    "Figures are tabular and do not reflow as they change. A screenshot at rest looks identical to the interface at rest.",
    "Honour prefers-reduced-motion. Durations collapse and the state change still happens.",
    "Only the components in this pack may be used. A design that needs something else is a request to add it here, not a local component in a feature folder.",
    "Every change ships behind a flag that is off. Merging is not releasing."
  ],
  "refuses": [
    {
      "id": "raw-value",
      "says": "No raw hex, rgb, or pixel value in a component where a token exists.",
      "enforced_by": "check-contract"
    },
    {
      "id": "outside-pack",
      "says": "No component imported from outside this pack.",
      "enforced_by": "check-contract"
    },
    {
      "id": "accent-spread",
      "says": "The accent colour is not used for decoration, headers, or borders that are not focus.",
      "enforced_by": "check-contract"
    },
    {
      "id": "brand-fork",
      "says": "A brand may not set a component-tier token, and may not omit a semantic key another brand has.",
      "enforced_by": "build-pack"
    },
    {
      "id": "motion-unguarded",
      "says": "A component that animates carries a prefers-reduced-motion guard in the same stylesheet.",
      "enforced_by": "check-contract"
    },
    {
      "id": "colour-alone",
      "says": "A state is never carried by colour alone.",
      "enforced_by": "review"
    }
  ],
  "visual": {
    "threshold": 0.02,
    "_comment": "Fraction of pixels allowed to differ between a story screenshot and the Figma frame export before the visual check comments on the pull request. Advisory in v1, see docs/DECISIONS.md."
  }
}
