{
  "name": "figma-design-system-sample",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "pack": "node design-system/build-pack.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:types": "tsc --noEmit",
    "test:lint": "biome check .",
    "test:pack": "node design-system/build-pack.mjs --check",
    "test:contract": "node scripts/check-contract.mjs",
    "test:all": "pnpm test:types && pnpm test:lint && pnpm test:pack && pnpm test:contract && pnpm test",
    "sync:figma": "node scripts/sync-figma-keys.mjs",
    "demo:status": "node scripts/demo.mjs status",
    "demo:reset": "node scripts/demo.mjs reset"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.0",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
